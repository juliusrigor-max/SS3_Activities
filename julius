<?php

$secretNumber = 250;
$guess = 246;

if ($secretNumber == $guess) {
    echo "<p>🎉 Congratulations! You guessed the correct number!</p>";
}elseif(abs($guess - $secretNumber) < 10){
    echo "<p>🔥 You're Getting Close!</p>";
}else{
    echo "<p>❌ Sorry, better luck next time!</p>";
}

?>

